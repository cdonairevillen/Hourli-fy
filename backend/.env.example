# Copia este archivo a backend/.env y ajusta los valores.
# En local apunta al Postgres de docker compose (mismas credenciales que el .env de la raíz).
DATABASE_URL=postgresql+psycopg://clockify:clockify@localhost:5432/clockify
# Clave para firmar los JWT. Genera una con: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esto-en-produccion
# Orígenes permitidos (JSON). En dev el proxy de Vite hace que no haga falta, pero se deja por si acaso.
CORS_ORIGINS=["http://localhost:5173"]
# Client ID de OAuth de Google (Google Cloud > APIs y servicios > Credenciales > ID de cliente web).
# Sin él, POST /api/auth/google responde 503. Debe ser el mismo que VITE_GOOGLE_CLIENT_ID del front.
GOOGLE_CLIENT_ID=
# Días que dura la sesión.
SESSION_DAYS=30
# En local (http, mismo origen vía proxy): false / lax. En producción (https, front en otro dominio): true / none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

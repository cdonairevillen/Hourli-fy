# Copia este archivo a frontend/.env y ajusta los valores.
# Client ID de OAuth de Google (el mismo que GOOGLE_CLIENT_ID en backend/.env).
VITE_GOOGLE_CLIENT_ID=
# Vacío en local y en producción: /api lo reenvía el proxy de Vite (local) o la Pages Function
# de frontend/functions (Cloudflare). Solo para apuntar el front a otra API sin proxy.
VITE_API_URL=
# Panel de admin. Vacío en local (/admin/ por el proxy de Vite). En producción, la URL de Cloud
# Run con /admin/ al final: https://hourlify-api-xxxx.europe-west1.run.app/admin/
VITE_ADMIN_URL=

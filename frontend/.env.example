# Copia este archivo a frontend/.env y ajusta los valores.
# Client ID de OAuth de Google (el mismo que GOOGLE_CLIENT_ID en backend/.env).
VITE_GOOGLE_CLIENT_ID=
# Vacío en local y en producción: en local /api lo reenvía el proxy de Vite y en producción la
# web y la API van en el mismo Cloud Run. Solo para apuntar el front a otra API.
VITE_API_URL=
# Panel de admin. Vacío = /admin/ del mismo dominio (lo normal, en local y en producción).
VITE_ADMIN_URL=
